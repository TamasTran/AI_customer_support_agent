APP_ENV=development

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
# Must match the output dimension of OLLAMA_EMBEDDING_MODEL (nomic-embed-text -> 768).
# Run `uv run python scripts/check_embedding_dimension.py` after changing the embedding model.
EMBEDDING_DIMENSION=768

DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
